# Discord bot token (Developer Portal -> Bot -> Token)
DISCORD_TOKEN=

# ElevenLabs API key (elevenlabs.io -> Profile -> API Keys)
ELEVENLABS_API_KEY=

# Optional overrides
# Voice to use (default: Rachel). Find IDs at elevenlabs.io/app/voice-library
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# eleven_flash_v2_5 = fast & cheap, supports 32 languages (incl. Turkish).
# eleven_multilingual_v2 = higher quality, slower.
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
# Messages longer than this get truncated before being read
MAX_MESSAGE_LENGTH=500
